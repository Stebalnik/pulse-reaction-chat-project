{
  "name": "pulse-reaction-chat",
  "version": "0.0.0",
  "private": true,
  "description": "Research-first rPPG project for consent-based physiological reaction trend experiments.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "check": "node scripts/check-repo.mjs",
    "dev": "pnpm --filter @pulse-reaction/browser-client dev",
    "format:check": "node scripts/check-repo.mjs --format",
    "lint": "node scripts/check-repo.mjs --lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4"
  }
}
