server {
    listen 80;
    listen [::]:80;
    server_name synvibe.app www.synvibe.app;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name synvibe.app www.synvibe.app;

    ssl_certificate /etc/letsencrypt/live/synvibe.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/synvibe.app/privkey.pem;

    root /var/www/synvibe.app/current;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:1060;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /admin {
        auth_basic "SynVibe admin";
        auth_basic_user_file /etc/nginx/synvibe-admin.htpasswd;
        try_files $uri $uri/ /index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
